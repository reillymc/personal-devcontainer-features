{
    "name": "Opencode",
    "id": "opencode",
    "version": "0.0.1",
    "description": "Installs opencode by SST with API keys configuration",
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.config/opencode",
            "target": "/etc/opencode",
            "type": "bind"
        }
    ]
}
