{
    "name": "Opencode",
    "id": "opencode",
    "version": "0.0.1",
    "description": "Installs opencode by SST with API keys configuration",
    "mounts": [
        {
            "source": "${localEnv:HOME}/.config/opencode/api-key",
            "target": "/etc/opencode/api-key",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.config/opencode/opencode.json",
            "target": "/etc/opencode/opencode.json",
            "type": "bind"
        }
    ]
}
